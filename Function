# Simple ATM Security Check

def check_pin(entered_pin):
    if entered_pin == 1234:
        return True
    else:
        return False


def bank_action(action_type, entered_pin):
    result = check_pin(entered_pin)

    if result == True:
        if action_type == "balance":
            print("Your balance is ₹5000")
        elif action_type == "withdraw":
            print("Withdrawal successful")
    else:
        print("Incorrect PIN, access denied.")


# Function calling
pin = int(input("Enter your PIN: "))
action = input("Enter action (balance/withdraw): ")

bank_action(action, pin)

# OUTPUT 1: (Balance)
Enter your PIN: 1234
Enter action (balance/withdraw): balance
Your balance is ₹5000

# OUTPUT 2: (withdraw)
Enter your PIN: 1234
Enter action (balance/withdraw): withdraw
Withdrawal successful

# OUTPUT 3: (Incorrect pin)
Enter your PIN: 1111
Enter action (balance/withdraw): balance
Incorrect PIN, access denied.
