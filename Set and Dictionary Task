# Task 1: Unique Number Analyzer (Set)
# Write a Python program to manage and analyze a collection of numbers using a set.

numbers = set()

# Get 10 numbers
for i in range(10):
    n = int(input("Enter a number: "))
    numbers.add(n)

# Display unique numbers
print("Unique Numbers:", numbers)

# Add a new number
numbers.add(100)
print("After add:", numbers)

# Remove a number
numbers.discard(10)
print("After remove:", numbers)

# Check number
print("20 exists:", 20 in numbers)

# Create another set
set2 = {10, 20, 30, 40, 50}
print("Second Set:", set2)

# Union
print("Union:", numbers.union(set2))

# Intersection
print("Intersection:", numbers.intersection(set2))

# Difference
print("Difference:", numbers.difference(set2))

# Total unique elements
print("Total Elements:", len(numbers))

