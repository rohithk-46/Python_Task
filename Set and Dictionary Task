# Task 2: Employee Details Management (Dictionary)
# Write a Python program to store and manage employee details using a dictionary.

employee = {
    "ID": 101,
    "name": "Ravi",
    "age": 25,
    "department": "IT",
    "salary": 30000
}

# Display all details
print("Employee Details:", employee)

# Access name and salary
print("Name:", employee["name"])
print("Salary:", employee["salary"])

# Add experience
employee["experience"] = "2 years"
print("After adding experience:", employee)

# Update salary
employee["salary"] = 40000
print("Updated Salary:", employee["salary"])

# Remove age
employee.pop("age")
print("After removing age:", employee)

# Display keys
print("Keys:", employee.keys())

# Display values
print("Values:", employee.values())

# Display keys and values
print("Employee Details:")
for key, value in employee.items():
    print(key, ":", value)

# Check department
if "department" in employee:
    print("Department key exists")
else:
    print("Department key does not exist")

