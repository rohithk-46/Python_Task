#1. Laptop Information

class Laptop:
    def __init__(self, brand, processor, ram, storage):
        self.brand = brand
        self.processor = processor
        self.ram = ram
        self.storage = storage

    def display(self):
        print("Laptop Information")
        print("Brand:", self.brand)
        print("Processor:", self.processor)
        print("RAM:", self.ram)
        print("Storage:", self.storage)


l1 = Laptop("HP", "Intel i5", "8GB", "512GB SSD")
l1.display()

#OUTPUT:
Laptop Information
Brand: HP
Processor: Intel i5
RAM: 8GB
Storage: 512GB SSD

