#2. Product Details

class Product:
    def __init__(self, pid, name, quantity, price):
        self.pid = pid
        self.name = name
        self.quantity = quantity
        self.price = price

    def display(self):
        print("Product Details")
        print("Product ID:", self.pid)
        print("Product Name:", self.name)
        print("Quantity:", self.quantity)
        print("Price:", self.price)


p1 = Product(101, "Laptop", 5, 45000)
p1.display()

#OUTPUT:
Product Details
Product ID: 101
Product Name: Laptop
Quantity: 5
Price: 45000

