#3. Movie Information

class Movie:
    def __init__(self, name, director, language, year):
        self.name = name
        self.director = director
        self.language = language
        self.year = year

    def display(self):
        print("Movie Information")
        print("Movie Name:", self.name)
        print("Director:", self.director)
        print("Language:", self.language)
        print("Release Year:", self.year)


m1 = Movie("Leo", "Lokesh Kanagaraj", "Tamil", 2023)
m1.display()

#OUTPUT:
Movie Information
Movie Name: Leo
Director: Lokesh Kanagaraj
Language: Tamil
Release Year: 2023
