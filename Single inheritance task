#1. Employee Salary Details

class Employee:
    def __init__(self, emp_id, emp_name):
        self.emp_id = emp_id
        self.emp_name = emp_name


class Salary(Employee):
    def __init__(self, emp_id, emp_name, basic_salary, bonus):
        super().__init__(emp_id, emp_name)
        self.basic_salary = basic_salary
        self.bonus = bonus

    def total_salary(self):
        return self.basic_salary + self.bonus

    def display(self):
        print("Employee ID:", self.emp_id)
        print("Employee Name:", self.emp_name)
        print("Basic Salary:", self.basic_salary)
        print("Bonus:", self.bonus)
        print("Total Salary:", self.total_salary())


obj = Salary(101, "Rohith", 25000, 5000)
obj.display()

#OUTPUT:
Employee ID: 101
Employee Name: Rohith
Basic Salary: 25000
Bonus: 5000
Total Salary: 30000

