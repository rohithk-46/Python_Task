# Task 1: Student Marks Management (List)

marks = []

# Get marks of 5 students
for i in range(5):
    m = int(input("Enter student mark: "))
    marks.append(m)

print("All Marks:", marks)

# Add a new mark
marks.append(85)
print("After append:", marks)

# Insert at second position
marks.insert(1, 90)
print("After insert:", marks)

# Remove a particular mark
marks.remove(60)
print("After remove:", marks)

# Highest and lowest marks
print("Highest mark:", max(marks))
print("Lowest mark:", min(marks))

# Total and average
print("Total:", sum(marks))
print("Average:", sum(marks) / len(marks))

# Sort marks
marks.sort()
print("Ascending order:", marks)

# Count marks above 75
count = 0
for m in marks:
    if m > 75:
        count += 1

print("Students scored above 75:", count)

# Display marks greater than or equal to 50
print("Marks >= 50:")
for m in marks:
    if m >= 50:
        print(m)

