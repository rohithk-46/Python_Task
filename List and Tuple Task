# Task 2: Shopping Cart Management (Tuple)
products = ("Apple", "Milk", "Bread", "Rice", "Apple")

# Display all products
print("All Products:", products)

# First and last products
print("First Product:", products[0])
print("Last Product:", products[-1])

# First 3 products
print("First 3 Products:", products[:3])

# Check product availability
print("Milk Available:", "Milk" in products)

# Count product
print("Apple Count:", products.count("Apple"))

# Find product position
print("Rice Position:", products.index("Rice"))

# Concatenate another tuple
new_products = ("Juice", "Eggs")
products = products + new_products
print("After Concatenation:", products)

# Repeat tuple twice
print("Repeated Tuple:", products * 2)

# Display each product
print("Each Product:")
for p in products:
    print(p)

