# 4. Positive and Negative Numbers: Get 10 numbers from the user. Check whether each number is positive, negative, or zero. Stop the loop if the user enters 0.
# Positive and Negative Numbers

for i in range(10):
    n = int(input("Enter a number: "))

    if n == 0:
        print("Zero entered. Loop stopped.")
        break
    elif n > 0:
        print("Positive number")
    else:
        print("Negative number")

# Output: Enter a number: 10
# Positive number
# Enter a number: -5
# Negative number
# Enter a number: 8
# Positive number
# Enter a number: 0
# Zero entered. Loop stopped.
